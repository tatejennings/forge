{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"anchor":"Testing-and-Contracts","identifiers":["doc:\/\/Forge\/documentation\/Forge\/OverrideBuilder","doc:\/\/Forge\/documentation\/Forge\/unimplemented(_:file:line:)"],"generated":true,"title":"Testing and Contracts"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Forge provides three mechanisms for overriding dependencies in tests, listed in order"},{"type":"text","text":" "},{"type":"text","text":"of preference. All examples use Swift Testing ("},{"type":"codeVoice","code":"@Test"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Suite"},{"type":"text","text":", "},{"type":"codeVoice","code":"#expect"},{"type":"text","text":")."}]},{"text":"Scoped Overrides with withOverrides (Preferred)","type":"heading","level":2,"anchor":"Scoped-Overrides-with-withOverrides-Preferred"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Container\/withOverrides(_:run:)-3qdpl"},{"type":"text","text":" registers overrides for the duration of a"},{"type":"text","text":" "},{"type":"text","text":"closure, then automatically restores the previous state. No manual cleanup required:"}]},{"code":["@Test(\"Login succeeds with valid credentials\")","func testLoginSuccess() async throws {","    let mock = MockAuthService(shouldSucceed: true)","","    try await AuthContainer.shared.withOverrides {","        $0.override(\\.authService) { mock }","    } run: {","        let viewModel = LoginViewModel()","        await viewModel.login(username: \"user\", password: \"pass\")","        #expect(mock.loginCalled)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Cleanup is guaranteed via ","type":"text"},{"type":"codeVoice","code":"defer"},{"text":" — even if the body throws, overrides are restored.","type":"text"},{"type":"text","text":" "},{"text":"Both sync and async variants are available:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Container\/withOverrides(_:run:)-3qdpl","type":"codeVoice"},{"text":" — synchronous","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Container\/withOverrides(_:run:)-4eui2","type":"codeVoice"},{"text":" — async (use when your test body contains ","type":"text"},{"code":"await","type":"codeVoice"},{"text":")","type":"text"}]}]}]},{"text":"Fresh State Between Tests","type":"heading","level":2,"anchor":"Fresh-State-Between-Tests"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/SharedContainer\/shared","isActive":true},{"type":"text","text":" is a stable "},{"type":"codeVoice","code":"let"},{"type":"text","text":" for the lifetime of the process — you"},{"type":"text","text":" "},{"type":"text","text":"don’t (and can’t) swap the instance. For test suites where every test needs a clean"},{"type":"text","text":" "},{"type":"text","text":"slate, reset the shared container in place with "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container\/resetAll()","isActive":true},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"suite’s "},{"type":"codeVoice","code":"init"},{"type":"text","text":". "},{"type":"codeVoice","code":"resetAll()"},{"type":"text","text":" clears all cached singletons, cached values, and"},{"type":"text","text":" "},{"type":"text","text":"registered overrides:"}]},{"syntax":"swift","type":"codeListing","code":["@Suite(\"LoginViewModel behavior\", .serialized)","struct LoginViewModelTests {","","    init() {","        AuthContainer.shared.resetAll()","    }","","    @Test(\"Login calls the auth service\")","    func testLoginCallsService() async throws {","        let mock = MockAuthService()","","        try await AuthContainer.shared.withOverrides {","            $0.override(\\.authService) { mock }","        } run: {","            let vm = LoginViewModel()","            await vm.login(username: \"test\", password: \"pass\")","            #expect(mock.loginCalled)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each test gets a fresh starting point with no leftover state from previous tests."},{"type":"text","text":" "},{"type":"text","text":"Mark such suites "},{"type":"codeVoice","code":".serialized"},{"type":"text","text":" so the in-place resets don’t race across tests."}]},{"text":"Direct Overrides (Escape Hatch)","type":"heading","level":2,"anchor":"Direct-Overrides-Escape-Hatch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"withOverrides"},{"type":"text","text":" closures are impractical, use "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container\/override(_:with:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"directly:"}]},{"syntax":"swift","type":"codeListing","code":["init() {","    AuthContainer.shared.resetAll()","    AuthContainer.shared.override(\\.authService) { MockAuthService() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the escape hatch — prefer "},{"type":"codeVoice","code":"withOverrides"},{"type":"text","text":" wherever possible because direct"},{"type":"text","text":" "},{"type":"text","text":"overrides require manual cleanup via "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container\/removeOverride(for:)","isActive":true},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container\/resetAll()","isActive":true},{"type":"text","text":"."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The first time a given KeyPath is overridden on a container (through either"},{"type":"text","text":" "},{"type":"text","text":"API), the override factory runs once during registration — Forge discovers the"},{"type":"text","text":" "},{"type":"text","text":"property’s storage key by evaluating its "},{"type":"codeVoice","code":"provide(...)"},{"type":"text","text":" call, and the factory"},{"type":"text","text":" "},{"type":"text","text":"supplies the getter’s return value. The probe’s value is discarded, and overrides"},{"type":"text","text":" "},{"type":"text","text":"are still resolved fresh (never cached) on every resolution. If a test spy counts"},{"type":"text","text":" "},{"type":"text","text":"factory invocations, expect one extra call on first registration — and don’t"},{"type":"text","text":" "},{"type":"text","text":"resolve sibling dependencies inside an override factory registered via the"},{"type":"text","text":" "},{"type":"codeVoice","code":"withOverrides"},{"type":"text","text":" builder, because the probe runs during "},{"type":"codeVoice","code":"configure"},{"type":"text","text":", before the"},{"type":"text","text":" "},{"type":"text","text":"builder’s other overrides are installed. The target property must call"},{"type":"text","text":" "},{"type":"codeVoice","code":"provide(...)"},{"type":"text","text":" with the property’s own type: a plain computed property (or one"},{"type":"text","text":" "},{"type":"text","text":"forwarding to a differently-typed dependency or another container) traps with a"},{"type":"text","text":" "},{"type":"text","text":"descriptive message, while a same-type alias ("},{"type":"codeVoice","code":"var alias: any P { backing }"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is discovered as its backing registration — overriding the alias overrides"},{"type":"text","text":" "},{"type":"codeVoice","code":"backing"},{"type":"text","text":" everywhere."}]}]},{"text":"The TestContainer Pattern with unimplemented","type":"heading","level":2,"anchor":"The-TestContainer-Pattern-with-unimplemented"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/unimplemented(_:file:line:)","isActive":true},{"type":"text","text":" makes dependency contracts explicit — any dependency"},{"type":"text","text":" "},{"type":"text","text":"that isn’t overridden crashes immediately instead of silently running the wrong code."},{"type":"text","text":" "},{"type":"text","text":"This is valuable in tests (shown here) and in cross-module proxies (see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/ModularArchitecture","isActive":true},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it to define a test container where every dependency fails loudly if called"},{"type":"text","text":" "},{"type":"text","text":"without being explicitly overridden:"}]},{"syntax":"swift","type":"codeListing","code":["final class TestAuthContainer: AuthContainer {","    override var authService: any AuthServiceProtocol {","        provide { unimplemented(\"authService\") }","    }","","    override var networkClient: any NetworkClientProtocol {","        provide { unimplemented(\"networkClient\") }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then in your tests, build the test container as an instance, override only what you"},{"type":"text","text":" "},{"type":"text","text":"need, and resolve through it explicitly with "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/ContainerInject","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["@Test(\"Login success flow\")","func testLoginSuccess() async throws {","    let container = TestAuthContainer()","","    try await container.withOverrides {","        $0.override(\\.authService) {","            MockAuthService(shouldSucceed: true)","        }","        \/\/ networkClient is unimplemented — if login accidentally","        \/\/ calls it, the test fails loudly instead of silently","        \/\/ executing live code","    } run: {","        let authService = ContainerInject(container, \\.authService).wrappedValue","        let vm = LoginViewModel(authService: authService)","        await vm.login(username: \"user\", password: \"pass\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This makes test contracts explicit — you declare exactly which dependencies a test"},{"type":"text","text":" "},{"type":"text","text":"exercises. Anything else is a bug."}]},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want the zero-argument "},{"type":"codeVoice","code":"@Inject(\\.x)"},{"type":"text","text":" to resolve from a test container"},{"type":"text","text":" "},{"type":"text","text":"without threading it through initializers, declare that container’s "},{"type":"codeVoice","code":"shared"},{"type":"text","text":" as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"static var"},{"type":"text","text":" (the "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/SharedContainer","isActive":true},{"type":"text","text":" requirement is only "},{"type":"codeVoice","code":"{ get }"},{"type":"text","text":", so a "},{"type":"codeVoice","code":"var"},{"type":"text","text":" "},{"type":"text","text":"satisfies it) and assign it in a "},{"type":"codeVoice","code":".serialized"},{"type":"text","text":" suite’s "},{"type":"codeVoice","code":"init"},{"type":"text","text":". Forge permits this;"},{"type":"text","text":" "},{"type":"text","text":"it just isn’t the default — prefer the stable "},{"type":"codeVoice","code":"let"},{"type":"text","text":" plus "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container\/resetAll()","isActive":true},{"type":"text","text":"."}]}]},{"text":"Best Practices","type":"heading","level":2,"anchor":"Best-Practices"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Prefer "},{"type":"codeVoice","code":"withOverrides"}]},{"text":" — automatic cleanup prevents test state leakage","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"resetAll()"},{"type":"text","text":" in suite "},{"type":"codeVoice","code":"init()"}]},{"text":" — gives each test a fresh starting point","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"unimplemented"},{"type":"text","text":" for test containers"}]},{"text":" — makes dependency boundaries explicit","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".serialized"},{"type":"text","text":" on suites"}]},{"text":" that reset or mutate ","type":"text"},{"code":"shared","type":"codeVoice"},{"text":" — prevents data races","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use protocol return types"}]},{"text":" on container properties — this is what makes mocks","type":"text"},{"text":" ","type":"text"},{"text":"substitutable for live implementations","type":"text"}]}]}]}]}],"abstract":[{"type":"text","text":"Mock dependencies in tests using scoped overrides, container reset, and explicit test contracts."}],"identifier":{"url":"doc:\/\/Forge\/documentation\/Forge\/TestingWithForge","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/forge\/testingwithforge"]}],"sections":[],"metadata":{"modules":[{"name":"Forge"}],"roleHeading":"Articl
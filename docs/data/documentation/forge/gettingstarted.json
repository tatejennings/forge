":"text","text":", which doesn’t work directly in SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"view structs. Instead, resolve directly from the container:"}],"type":"paragraph"},{"type":"codeListing","code":["struct LoginView: View {","    @State private var viewModel = AppContainer.shared.loginViewModel","","    var body: some View {","        \/\/ use viewModel...","    }","}"],"syntax":"swift"},{"type":"heading","text":"Inline resolution","level":3,"anchor":"Inline-resolution"},{"inlineContent":[{"type":"text","text":"You can also resolve dependencies directly without the property wrapper:"}],"type":"paragraph"},{"type":"codeListing","code":["let service = AppContainer.shared.authService"],"syntax":"swift"},{"type":"heading","text":"Next Steps","level":2,"anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Forge\/documentation\/Forge\/ModularArchitecture","isActive":true,"type":"reference"},{"type":"text","text":" — organize containers across multiple modules"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Forge\/documentation\/Forge\/TestingWithForge","type":"reference","isActive":true},{"type":"text","text":" — mock dependencies in tests"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Forge\/documentation\/Forge\/XcodePreviewSupport","isActive":true,"type":"reference"},{"type":"text","text":" — provide preview-safe factories"}]}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Install Forge and register your first dependencies."}],"identifier":{"url":"doc:\/\/Forge\/documentation\/Forge\/GettingStarted","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/forge\/gettingstarted"]}],"sections":[],"metadata":{"roleHeading":"Article","title":"Getting Started with Forge","role":"article","modules":[{"name":"Forge"}]},"hierarchy":{"paths":[["doc:\/\/Forg
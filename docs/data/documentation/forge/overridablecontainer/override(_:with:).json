{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Overrides the dependency at the given KeyPath with the provided factory.","type":"text"}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"override","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"keyPath","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"KeyPath","kind":"typeIdentifier","preciseIdentifier":"s:s7KeyPathC"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"with","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"factory","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@escaping ","kind":"attribute"},{"text":"@Sendable","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":")","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A KeyPath to the container property to override."}]}],"name":"keyPath"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that produces the override value."}]}],"name":"factory"}]},{"kind":"mentions","mentions":["doc:\/\/Forge\/documentation\/Forge\/ModularArchitecture","doc:\/\/Forge\/documentation\/Forge\/XcodePreviewSupport"]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Compile-time safe — the property must exist on the container and the","type":"text"},{"text":" ","type":"text"},{"text":"return type is inferred from the KeyPath. Works with Xcode rename refactoring.","type":"text"},{"text":" ","type":"text"},{"text":"The storage key is discovered by evaluating the property’s own","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/Container\/provide(_:key:_:preview:)","type":"reference","isActive":true},{"text":" registration, so it always matches","type":"text"},{"text":" ","type":"text"},{"text":"the key used at resolution — including properties registered with an","type":"text"},{"text":" ","type":"text"},{"text":"explicit ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":" parameter, and regardless of build settings such as symbol","type":"text"},{"text":" ","type":"text"},{"text":"stripping.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use this for ","type":"text"},{"code":"setUp","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"tearDown","type":"codeVoice"},{"text":" patterns where the closure-based","type":"text"},{"text":" ","type":"text"},{"code":"withOverrides(_:run:)-3qdpl","type":"codeVoice"},{"text":" is impractical.","type":"text"}],"type":"paragraph"},{"code":["AppContainer.shared.override(\\.authService) { MockAuthService() }"],"syntax":"swift","type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The first time a given KeyPath is overridden on a container, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"factory"},{"type":"text","text":" runs once during registration to complete the key discovery."},{"type":"text","text":" "},{"type":"text","text":"Its value is discarded; overrides are still resolved fresh (never cached)"},{"type":"text","text":" "},{"type":"text","text":"on every subsequent resolution. Wiring closures should therefore capture"},{"type":"text","text":" "},{"type":"text","text":"an already-resolved value rather than resolve other dependencies inline,"},{"type":"text","text":" "},{"type":"text","text":"or those resolutions happen eagerly at registration time."}]}],"name":"Note","type":"aside"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The target property must call "},{"type":"codeVoice","code":"provide(...)"},{"type":"text","text":" with the"},{"type":"text","text":" "},{"type":"text","text":"property’s own type, directly in its getter. Overriding a plain computed"},{"type":"text","text":" "},{"type":"text","text":"property (or one that forwards to a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"differently-typed"}]},{"type":"text","text":" dependency or to"},{"type":"text","text":" "},{"type":"text","text":"another container) traps immediately with a descriptive message — a loud"},{"type":"text","text":" "},{"type":"text","text":"failure at wiring time rather than a misleading one at resolution."},{"type":"text","text":" "},{"type":"text","text":"A property that forwards to a provide-backed sibling of the "},{"type":"strong","inlineContent":[{"type":"text","text":"same type"}]},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"var alias: any P { backing }"},{"type":"text","text":") is discovered as its backing"},{"type":"text","text":" "},{"type":"text","text":"registration: overriding the alias overrides "},{"type":"codeVoice","code":"backing"},{"type":"text","text":" container-wide."}]}],"name":"Important","type":"aside"}]}],"variants":[{"paths":["\/documentation\/forge\/overridablecontainer\/override(_:with:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Forge\/documentation\/Forge","doc:\/\/Forge\/documentation\/Forge\/OverridableContainer"]]},"metadata":{"externalID":"s:5Forge20OverridableContainerPAAE8override_4withys7KeyPathCyxqd__G_qd__yYbctlF","role":"symbol","modules":[{"name":"Forge"}],"roleHeading":"Instance Method","title":"override(_:with:)","extendedModule":"Forge","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier",
{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","seeAlsoSections":[{"anchor":"Architecture-and-Best-Practices","identifiers":["doc:\/\/Forge\/documentation\/Forge\/ModularArchitecture","doc:\/\/Forge\/documentation\/Forge\/XcodePreviewSupport"],"generated":true,"title":"Architecture and Best Practices"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Forge is designed to make SOLID principles the path of least resistance. Each","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"principle applies to both the framework’s internal design and how you structure"},{"text":" ","type":"text"},{"type":"text","text":"your own code when using it."}]},{"text":"Single Responsibility Principle","type":"heading","level":2,"anchor":"Single-Responsibility-Principle"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Each type should have one reason to change.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"In the framework:","type":"text"}]},{"type":"text","text":" Every Forge type does one thing — "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container","isActive":true},{"text":" manages","type":"text"},{"type":"text","text":" "},{"text":"lifecycle and resolution, ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/Scope","type":"reference","isActive":true},{"type":"text","text":" describes caching behavior,"},{"type":"text","text":" "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/ContainerInject","type":"reference","isActive":true},{"text":" handles injection, ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/OverrideBuilder","isActive":true,"type":"reference"},{"text":" handles test","type":"text"},{"type":"text","text":" "},{"type":"text","text":"configuration."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"In your code:","type":"text"}],"type":"strong"},{"text":" Each container should own dependencies for exactly one module.","type":"text"},{"type":"text","text":" "},{"text":"If a container grows beyond its module’s concerns, that signals the module has","type":"text"},{"type":"text","text":" "},{"text":"too many responsibilities.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Correct: one container per module","final class AuthContainer: Container, SharedContainer {","    static let shared = AuthContainer()","","    var authService: any AuthServiceProtocol {","        provide(.singleton) { AuthService() }","    }","}","","final class AnalyticsContainer: Container, SharedContainer {","    static let shared = AnalyticsContainer()","","    var tracker: any AnalyticsTrackerProtocol {","        provide(.singleton) { MixpanelTracker() }","    }","}"]},{"type":"heading","text":"Open\/Closed Principle","level":2,"anchor":"OpenClosed-Principle"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Open for extension, closed for modification.","type":"text"}]}],"name":"Note","style":"note"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"In the framework:","type":"text"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container","isActive":true},{"text":" is an ","type":"text"},{"type":"codeVoice","code":"open class"},{"text":". New containers extend it","type":"text"},{"type":"text","text":" "},{"type":"text","text":"by adding computed properties — you never modify the base class."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"In your code:"}]},{"type":"text","text":" Change behavior by overriding at the container boundary, not by"},{"type":"text","text":" "},{"type":"text","text":"modifying implementation types. A test that needs different behavior provides a"},{"type":"text","text":" "},{"type":"text","text":"different factory:"}]},{"type":"codeListing","code":["\/\/ Correct: extend at the container boundary","try await AuthContainer.shared.withOverrides {","    $0.override(\\.authService) { MockAuthService() }","} run: {","    \/\/ test code...","}","","\/\/ Incorrect: adding test flags inside production types","class AuthService {","    var isTesting = false  \/\/ Don't do this","}"],"syntax":"swift"},{"anchor":"Liskov-Substitution-Principle","type":"heading","level":2,"text":"Liskov Substitution Principle"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"Subtypes must be substitutable for their base types.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"In the framework:"}]},{"text":" ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/Container","isActive":true,"type":"reference"},{"text":" subclasses are always valid containers. The","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"base class API works identically on any subclass."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"In your code:"}]},{"text":" Always declare container properties using protocol return types.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This is what makes mocks substitutable for live implementations:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Correct: protocol return type — mock is substitutable","public var authService: any AuthServiceProtocol {","    provide(.singleton) { AuthService() }","}","","\/\/ Incorrect: concrete type — cannot substitute a mock","public var authService: AuthService {","    provide(.singleton) { AuthService() }","}"]},{"inlineContent":[{"text":"When the return type is a protocol, any conforming type — live or mock — can be","type":"text"},{"type":"text","text":" "},{"text":"swapped in without changing consuming code.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Interface Segregation Principle","anchor":"Interface-Segregation-Principle","level":2},{"type":"aside","content":[{"inlineContent":[{"text":"Clients should not depend on interfaces they do not use.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"In the framework:"}],"type":"strong"},{"type":"text","text":" "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/SharedContainer","type":"reference","isActive":true},{"type":"text","text":" is a minimal protocol with a single"},{"text":" ","type":"text"},{"type":"text","text":"requirement ("},{"code":"static var shared { get }","type":"codeVoice"},{"type":"text","text":", satisfied by a "},{"code":"static let","type":"codeVoice"},{"type":"text","text":"). "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/Container","isActive":true,"type":"reference"},{"type":"text","text":" does not conform to it by"},{"type":"text","text":" "},{"type":"text","text":"default — you opt in only when you need the zero-argument "},{"code":"@Inject","type":"codeVoice"},{"type":"text","text":" syntax."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"In your code:"}],"type":"strong"},{"type":"text","text":" Define narrow protocols for each dependency. A"},{"type":"text","text":" "},{"code":"NetworkClientProtocol","type":"codeVoice"},{"type":"text","text":" should not carry authentication methods just because the"},{"type":"text","text":" "},{"type":"text","text":"networking layer also handles auth:"}]},{"type":"codeListing","code":["\/\/ Correct: narrow protocols","protocol NetworkClientProtocol {","    func request<T: Decodable>(_ endpoint: Endpoint) async throws -> T","}","","protocol AuthTokenProviderProtocol {","    var currentToken: String? { get }","}","","\/\/ Incorrect: fat protocol","protocol NetworkClientProtocol {","    func request<T: Decodable>(_ endpoint: Endpoint) async throws -> T","    var currentToken: String? { get }   \/\/ Not a networking concern","    func logout()                        \/\/ Definitely not networking","}"],"syntax":"swift"},{"type":"heading","text":"Dependency Inversion Principle","anchor":"Dependency-Inversion-Principle","level":2},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"High-level modules should not depend on low-level modules. Both should depend","type":"text"},{"text":" ","type":"text"},{"text":"on abstractions.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"This is Forge’s entire purpose."}]},{"text":" The container is the composition root — the","type":"text"},{"text":" ","type":"text"},{"text":"only place where abstractions are wired to concrete implementations. Everything","type":"text"},{"text":" ","type":"text"},{"text":"above it (ViewModels, services) depends only on protocols. Everything below it","type":"text"},{"text":" ","type":"text"},{"text":"(concrete implementations) knows nothing about the container.","type":"text"}]},{"type":"codeListing","code":["CoreProtocols (protocols only — no Forge import)","       ^","       |","Feature modules (depend on protocols, use Forge for wiring)","       ^","       |","App target (imports both, wires at startup)"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"ViewModels and services never ","type":"text"},{"code":"import","type":"codeVoice"},{"text":" a concrete implementation module directly.","type":"text"},{"text":" ","type":"text"},{"text":"They inject via protocol. The container handles the wiring:","type":"text"}]},{"type":"codeListing","code":["\/\/ ViewModel depends only on the protocol","final class LoginViewModel: ObservableObject {","    @Inject(\\.authService) private var authService","    \/\/ LoginViewModel has no idea what AuthService is —","    \/\/ it only knows AuthServiceProtocol","}"],"syntax":"swift"},{"type":"heading","text":"Summary","anchor":"Summary","level":2},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Principle"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Forge Pattern"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single Responsibility"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"One container per module"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open\/Closed"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Override at the container, don’t modify types"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Liskov Substitution"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Protocol return types on all properties"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Interface Segregation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrow protocols, opt-in "},{"type":"codeVoice","code":"SharedContainer"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependency Inversion"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Container is the composition root"}]}]]]}]}],"abstract":[{"type":"text","text":"How each SOLID principle maps to Forge usage, with practical Swift examples."}],"identifier":{"url":"doc:\/\/Forge\/documentation\/Forge\/SOLIDPrinciples","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/forge\/solidprinciples"]}],"sections":[],"metadata":{"role":"article","title":"SOLID Principles with Forge","modules":[{"name":"Forge"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Forge\/documentation\/Forge"]]},"references":{"doc://Forge/documentation/Forge/Scope":{"url":"\/documentation\/forge\/scope","kind":"sy
:[{"kind":"identifier","text":"Container"}],"identifier":"doc:\/\/Forge\/documentation\/Forge\/Container","abstract":[{"type":"text","text":"The base class for all dependency containers in Forge."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Container"}],"type":"topic","title":"Container"},"doc://Forge/documentation/Forge/SharedContainer":{"url":"\/documentation\/forge\/sharedcontainer","kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SharedContainer","kind":"identifier"}],"abstract":[{"type":"text","text":"A container that provides a shared static instance for convenient access."}],"navigatorTitle":[{"text":"SharedContainer","kind":"identifier"}],"identifier":"doc:\/\/Forge\/documentation\/Forge\/SharedContainer","role":"symbol","title":"SharedContainer"},"doc://Forge/documentation/Forge/ContainerInject":{"navigatorTitle":[{"text":"ContainerInject","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A property wrapper that lazily resolves a dependency from a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Forge\/documentation\/Forge\/Container"},{"type":"text","text":"."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ContainerInject","kind":"identifier"}],"type":"topic","title":"ContainerInject","url":"\/documentation\/forge\/containerinject","kind":"symbol","identifier":"doc:\/\/Forge\/documentation\/Forge\/ContainerInject"},"doc://Forge/documentation/Forge":{"role":"collection","abstract":[{"type":"text","text":"A lightweight dependency injection framework for Swift — compile-time-safe at the call site, with loud, fail-fast runtime checks underneath."}],"type":"topic","title":"Forge","url":"\/documentation\/forge","identifier":"doc:\/\/Forge\/documentation\/Forge","kind":"symbol"}}}
{"hierarchy":{"paths":[["doc:\/\/Forge\/documentation\/Forge"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Forge\/documentation\/Forge\/SOLIDPrinciples","doc:\/\/Forge\/documentation\/Forge\/XcodePreviewSupport"],"title":"Architecture and Best Practices","generated":true,"anchor":"Architecture-and-Best-Practices"}],"abstract":[{"type":"text","text":"Organize dependency injection across multiple Swift Package Manager modules."}],"metadata":{"role":"article","title":"Modular Architecture","modules":[{"name":"Forge"}],"roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In a modular codebase, each SPM module owns its own "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/Container","type":"reference","isActive":true},{"type":"text","text":" subclass. This"},{"type":"text","text":" "},{"type":"text","text":"keeps dependency boundaries clean, makes modules independently testable, and"},{"type":"text","text":" "},{"type":"text","text":"prevents accidental cross-module coupling."}]},{"type":"heading","text":"One Container per Module","level":2,"anchor":"One-Container-per-Module"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each module defines exactly one container that manages all dependencies for that"},{"type":"text","text":" "},{"type":"text","text":"module. The container file includes the module-local typealias:"}]},{"code":["\/\/ FeatureAuth\/Sources\/AuthContainer.swift","","import Forge","import CoreProtocols","","typealias Inject<T> = ContainerInject<AuthContainer, T>","","public final class AuthContainer: Container, SharedContainer {","    public static let shared = AuthContainer()","","    public var authService: any AuthServiceProtocol {","        provide(.singleton) {","            AuthService(network: self.networkClient)","        } preview: {","            MockAuthService()","        }","    }","","    public var networkClient: any NetworkClientProtocol {","        provide(.singleton) { URLSessionNetworkClient() }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"All "},{"code":"@Inject","type":"codeVoice"},{"type":"text","text":" usages within the module use the bare syntax — no container name visible:"}],"type":"paragraph"},{"code":["\/\/ FeatureAuth\/Sources\/LoginViewModel.swift","","final class LoginViewModel: ObservableObject {","    @Inject(\\.authService) private var auth","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Cross-Module Proxying","level":2,"anchor":"Cross-Module-Proxying"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature modules must not import other feature modules directly. If a module needs a"},{"text":" ","type":"text"},{"text":"dependency owned by another module, it ","type":"text"},{"type":"strong","inlineContent":[{"text":"proxies","type":"text"}]},{"text":" the dependency through its own","type":"text"},{"text":" ","type":"text"},{"text":"container using ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/unimplemented(_:file:line:)","type":"reference","isActive":true},{"text":" as the default factory. The app target","type":"text"},{"type":"text","text":" "},{"text":"wires the real implementation at startup via ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/OverridableContainer\/override(_:with:)","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ FeatureSearch\/Sources\/SearchContainer.swift","","import Forge","","public final class SearchContainer: Container, SharedContainer {","    public static let shared = SearchContainer()","","    \/\/ Wired by the app target — crashes if not overridden","    public var analytics: any AnalyticsProtocol {","        provide(.singleton) {","            unimplemented(\"analytics\")","        } preview: {","            MockAnalytics()","        }","    }","","    public var searchService: any SearchServiceProtocol {","        provide(.singleton) {","            SearchService(analytics: self.analytics)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Using ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/unimplemented(_:file:line:)","isActive":true,"type":"reference"},{"type":"text","text":" here means that if the composition root forgets"},{"text":" ","type":"text"},{"type":"text","text":"to wire "},{"type":"codeVoice","code":"analytics"},{"type":"text","text":", the app crashes on launch with a clear message instead of"},{"type":"text","text":" "},{"type":"text","text":"silently running on mock data."}]},{"text":"Benefits of Proxying","type":"heading","level":3,"anchor":"Benefits-of-Proxying"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fail-fast safety"}]},{"text":" — ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/unimplemented(_:file:line:)","type":"reference","isActive":true},{"text":" catches missing wiring immediately","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Test isolation"}]},{"text":" — override ","type":"text"},{"code":"analytics","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"SearchContainer","type":"codeVoice"},{"text":" directly, without","type":"text"},{"text":" ","type":"text"},{"text":"touching another module’s container","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Clean dependency graph"}]},{"text":" — each module’s DI surface is fully within its own container","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Swappability"}]},{"text":" — if the analytics provider changes, only the override needs updating","type":"text"}]}]}]},{"type":"heading","text":"The Composition Root","anchor":"The-Composition-Root","level":2},{"type":"paragraph","inlineContent":[{"text":"The app target is the ","type":"text"},{"type":"strong","inlineContent":[{"text":"composition root","type":"text"}]},{"text":" — the only place where all modules are","type":"text"},{"type":"text","text":" "},{"text":"imported and containers are wired together. Put the wiring in a dedicated","type":"text"},{"type":"text","text":" "},{"code":"CompositionRoot.swift","type":"codeVoice"},{"type":"text","text":" as a "},{"type":"strong","inlineContent":[{"type":"text","text":"standalone "},{"code":"wireContainers()","type":"codeVoice"},{"type":"text","text":" function"}]},{"text":" (not a method","type":"text"},{"text":" ","type":"text"},{"text":"on ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/AppContainer","type":"reference","isActive":true},{"text":"), and call it once from ","type":"text"},{"code":"App.init()","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ App\/Sources\/CompositionRoot.swift","","import Forge","import FeatureAuth","import FeatureSearch","import CoreAnalytics","","\/\/ MARK: - Target-level services (OPTIONAL)","\/\/ Only if the app target itself owns dependencies that live in no module. A thin app","\/\/ target omits this entirely — then `AppContainer` never appears.","\/\/","\/\/   extension AppContainer {","\/\/       var someAppService: any SomeProtocol { provide(.singleton) { SomeService() } }","\/\/   }","","\/\/ MARK: - Composition root — wire feature proxies once, at launch","func wireContainers() {","    \/\/ Wire each feature module's `unimplemented` proxy to the real implementation,","    \/\/ read from the module container that owns it. Containers are stable singletons —","    \/\/ wire with `override`, never by reassigning `shared`.","    let analytics = CoreAnalyticsContainer.shared.analytics","    SearchContainer.shared.override(\\.analytics) { analytics }","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ App\/Sources\/MyApp.swift","@main","struct MyApp: App {","    init() { wireContainers() }","    var body: some Scene { WindowGroup { RootView() } }","}"],"syntax":"swift"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The first "},{"code":"override(\\.x)","type":"codeVoice"},{"type":"text","text":" for a KeyPath runs its closure once at"},{"type":"text","text":" "},{"type":"text","text":"registration (key discovery), so wiring closures execute during"},{"type":"text","text":" "},{"code":"wireContainers()","type":"codeVoice"},{"type":"text","text":" — prefer the capture-first form shown above"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"let analytics = …","type":"codeVoice"},{"type":"text","text":" then "},{"code":"override(\\.analytics) { analytics }","type":"codeVoice"},{"type":"text","text":") over a"},{"type":"text","text":" "},{"type":"text","text":"read-through closure, which would resolve the real at wiring time anyway,"},{"type":"text","text":" "},{"type":"text","text":"just less visibly. If one real transitively depends on another container’s"},{"type":"text","text":" "},{"type":"text","text":"proxy, wire that proxy on an earlier line: wiring is order-sensitive for"},{"type":"text","text":" "},{"type":"text","text":"cross-dependent reals. The target must be a provide-backed property of the"},{"type":"text","text":" "},{"type":"text","text":"same type; see "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/OverridableContainer\/override(_:with:)","type":"reference","isActive":true},{"type":"text","text":" for the full"},{"type":"text","text":" "},{"type":"text","text":"discovery rules."}]}]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The real implementations live in the module that owns them (here,"},{"type":"text","text":" "},{"code":"CoreAnalytics","type":"codeVoice"},{"type":"text","text":"’s own container) — not on "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/AppContainer","type":"reference","isActive":true},{"type":"text","text":". "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/AppContainer","type":"reference","isActive":true},{"type":"text","text":" is"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"optional"}],"type":"strong"},{"type":"text","text":" in a modular app: use it only for genuine "},{"inlineContent":[{"type":"text","text":"target-level"}],"type":"emphasis"},{"type":"text","text":" services the"},{"type":"text","text":" "},{"type":"text","text":"app itself owns. A thin app target whose modules own everything never touches it."},{"type":"text","text":" "},{"type":"text","text":"And keep the wiring a free function — making it a method on "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/AppContainer","type":"reference","isActive":true},{"type":"text","text":" makes"},{"type":"text","text":" "},{"type":"text","text":"the composition root read like the Simple path."}]}]},{"type":"heading","text":"Consuming a Module Container from the App Target","anchor":"Consuming-a-Module-Container-from-the-App-Target","level":2},{"type":"paragraph","inlineContent":[{"text":"Inside a feature module, ","type":"text"},{"code":"@Inject(\\.x)","type":"codeVoice"},{"text":" works because the module’s local","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/Inject","type":"reference","isActive":true},{"text":" typealias (","type":"text"},{"code":"typealias Inject<T> = ContainerInject<XContainer, T>","type":"codeVoice"},{"text":") is in","type":"text"},{"text":" ","type":"text"},{"text":"scope. That typealias is internal to the module, so ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"at the app target the bare"},{"type":"text","text":" "},{"code":"@Inject(\\.x)","type":"codeVoice"},{"type":"text","text":" resolves only from "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/AppContainer","type":"reference","isActive":true}]},{"text":" — it cannot reach a feature","type":"text"},{"text":" ","type":"text"},{"text":"container.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You do not need ","type":"text"},{"code":"SomeContainer.shared.dependency","type":"codeVoice"},{"text":" to bridge that gap. Use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/ContainerInject","type":"reference","isActive":true},{"text":"’s explicit-container initializer, which is fully type-inferred:","type":"text"}]},{"type":"codeListing","code":["\/\/ App target — e.g. an app-level coordinator that needs a feature's service","final class RootCoordinator {","    @ContainerInject(TaskContainer.shared, \\.taskService) private var taskService","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"For repeated use, declare a per-container typealias at the app target, mirroring the","type":"text"},{"text":" ","type":"text"},{"text":"in-module idiom:","type":"text"}]},{"type":"codeListing","code":["typealias TasksInject<T> = ContainerInject<TaskContainer, T>","","@TasksInject(\\.taskService) private var taskService"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Both forms give the same lazy resolution, caching, and override-awareness as the","type":"text"},{"text":" ","type":"text"},{"text":"bare ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/Inject","type":"reference","isActive":true},{"text":". This is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" a layering violation — the app target is the","type":"text"},{"text":" ","type":"text"},{"text":"composition root and already imports every module.","type":"text"}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The bare "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/Inject","type":"reference","isActive":true},{"type":"text","text":" is intentionally bound to a single container. Resolving"},{"type":"text","text":" "},{"code":"@Inject(\\.x)","type":"codeVoice"},{"type":"text","text":" across containers would require runtime cross-container lookup"},{"type":"text","text":" "},{"type":"text","text":"(a service locator), which Forge does not do — the fixed-container typealias is"},{"type":"text","text":" "},{"type":"text","text":"what makes resolution compile-time-safe. Prefer registering app-level needs on"},{"type":"text","text":" "},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/AppContainer","type":"reference","isActive":true},{"type":"text","text":"; reach into a feature container only when the app genuinely needs"},{"type":"text","text":" "},{"type":"text","text":"something that feature owns."}]}]},{"type":"heading","text":"Import Dependency Graph","anchor":"Import-Dependency-Graph","level":2},{"type":"paragraph","inlineContent":[{"text":"The correct architecture follows this pattern:","type":"text"}]},{"type":"codeListing","code":["CoreProtocols (protocols only — no Forge import)","       ^","       |","  Feature modules (each has its own Container)","       ^","       |","  App target (imports all modules, wires containers)"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Key rules:"}]}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Protocol modules define abstractions only — no Forge dependency needed"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Feature modules import protocol modules and Forge"}],"type":"paragraph"}]},{"content":[{"inlineCon
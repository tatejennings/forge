{"hierarchy":{"paths":[["doc:\/\/Forge\/documentation\/Forge"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Dependencies that hit the network, access the file system, or perform heavy"},{"type":"text","text":" "},{"type":"text","text":"computation are problematic in Xcode Previews. Forge lets you provide a "},{"type":"codeVoice","code":"preview"},{"type":"text","text":" "},{"type":"text","text":"factory that is used automatically when running inside a preview — no conditional"},{"type":"text","text":" "},{"type":"text","text":"checks needed in your view code."}],"type":"paragraph"},{"anchor":"The-preview-Parameter","type":"heading","level":2,"text":"The preview Parameter"},{"inlineContent":[{"type":"text","text":"Pass a "},{"type":"codeVoice","code":"preview"},{"type":"text","text":" closure to "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container\/provide(_:key:_:preview:)","isActive":true},{"type":"text","text":" alongside the"},{"type":"text","text":" "},{"type":"text","text":"normal factory:"}],"type":"paragraph"},{"code":["public var authService: any AuthServiceProtocol {","    provide(.singleton) {","        AuthService(network: self.networkClient)","    } preview: {","        MockAuthService()","    }","}","","public var networkClient: any NetworkClientProtocol {","    provide(.singleton) {","        URLSessionNetworkClient()","    } preview: {","        MockNetworkClient()","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When the code runs inside an Xcode Preview, "},{"type":"codeVoice","code":"MockAuthService()"},{"type":"text","text":" is returned. In"},{"type":"text","text":" "},{"type":"text","text":"production, "},{"type":"codeVoice","code":"AuthService(network:)"},{"type":"text","text":" is returned."}],"type":"paragraph"},{"anchor":"How-Preview-Detection-Works","type":"heading","level":2,"text":"How Preview Detection Works"},{"inlineContent":[{"type":"text","text":"Forge detects the preview environment by checking for the "},{"type":"codeVoice","code":"XCODE_RUNNING_FOR_PREVIEWS"},{"type":"text","text":" "},{"type":"text","text":"environment variable, which Xcode sets to "},{"type":"codeVoice","code":"\"1\""},{"type":"text","text":" when rendering previews. This is the"},{"type":"text","text":" "},{"type":"text","text":"standard detection mechanism used across the Swift community."}],"type":"paragraph"},{"anchor":"Resolution-Precedence","type":"heading","level":3,"text":"Resolution Precedence"},{"inlineContent":[{"type":"text","text":"When "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Container\/provide(_:key:_:preview:)","isActive":true},{"type":"text","text":" is called, resolution follows this order:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Overrides","type":"text"}]},{"type":"text","text":" — always checked first (test overrides take priority)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Preview factory","type":"text"}]},{"type":"text","text":" — used if running in a preview and a "},{"type":"codeVoice","code":"preview"},{"type":"text","text":" closure was provided"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Normal factory","type":"text"}]},{"type":"text","text":" — the default production path"}]}]}],"type":"orderedList"},{"anchor":"Preview-Values-Are-Never-Cached","type":"heading","level":2,"text":"Preview Values Are Never Cached"},{"inlineContent":[{"type":"text","text":"Preview factories are called fresh on every resolution, regardless of the declared"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Forge\/documentation\/Forge\/Scope","isActive":true},{"type":"text","text":". Even if a dependency is registered as "},{"type":"codeVoice","code":".singleton"},{"type":"text","text":", the preview factory"},{"type":"text","text":" "},{"type":"text","text":"runs every time in a preview context. This ensures previews always reflect the latest"},{"type":"text","text":" "},{"type":"text","text":"mock state."}],"type":"paragraph"},{"anchor":"When-to-Provide-a-Preview-Factory","type":"heading","level":2,"text":"When to Provide a Preview Factory"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Provide one for:","type":"text"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Network clients and API services"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Database and file system access"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Analytics and logging services"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any dependency that performs I\/O or has side effects"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Skip it for:","type":"text"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pure in-memory services (formatters, validators, parsers)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Simple value types or data transformations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependencies that already work correctly without network access"}]}]}],"type":"unorderedList"},{"anchor":"Multiple-Preview-Variants","type":"heading","level":2,"text":"Multiple Preview Variants"},{"inlineContent":[{"type":"text","text":"Use different overrides within "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks to show different states:"}],"type":"paragraph"},{"code":["#Preview(\"Logged In\") {","    AuthContainer.shared.override(\\.authService) {","        MockAuthService(isLoggedIn: true)","    }","    return ProfileView()","}","","#Preview(\"Logged Out\") {","    AuthContainer.shared.override(\\.authService) {","        MockAuthService(isLoggedIn: false)","    }","    return ProfileView()","}","","#Preview(\"Error State\") {","    AuthContainer.shared.override(\\.authService) {","        MockAuthService(shouldFail: true)","    }","    return ProfileView()","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This lets you preview the same view in multiple states without changing any production"},{"type":"text","text":" "},{"type":"text","text":"code."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The first ","type":"text"},{"code":"override(\\.authService)","type":"codeVoice"},{"text":" for a KeyPath runs its closure once","type":"text"},{"text":" ","type":"text"},{"text":"at registration to discover the property’s storage key — here that just builds","type":"text"},{"text":" ","type":"text"},{"text":"one extra discarded ","type":"text"},{"code":"MockAuthService","type":"codeVoice"},{"text":", which is harmless. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Forge\/documentation\/Forge\/OverridableContainer\/override(_:with:)","type":"reference","isActive":true},{"text":" for the discovery rules.","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"anchor":"Testing-Preview-Behavior","type":"heading","level":2,"text":"Testing Preview Behavior"},{"inlineContent":[{"type":"text","text":"The framework includes an internal "},{"type":"codeVoice","code":"_isPreviewOverride"},{"type":"text","text":" property (accessible via"},{"type":"text","text":" "},{"type":"codeVoice","code":"@testable import"},{"type":"text","text":") that lets tests simulate the preview environment:"}],"type":"paragraph"},{"code":["@testable import Forge","","PreviewContext._isPreviewOverride = true","defer { PreviewContext._isPreviewOverride = nil }","","\/\/ Dependencies now use their preview factories","let service = MyContainer.shared.authService","\/\/ service is MockAuthService"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tests using ","type":"text"},{"code":"_isPreviewOverride","type":"codeVoice"},{"text":" must be marked ","type":"text"},{"code":".serialized","type":"codeVoice"},{"text":" to prevent","type":"text"},{"text":" ","type":"text"},{"text":"data races, since this is a global mutable state.","type":"text"}]}],"style":"note","type":"aside","name":"Note"}]}],"kind":"article","sections":[],"seeAlsoSections":[{"title":"Architecture and Best Practices","anchor":"Architecture-and-Best-Practices","identifiers":["doc:\/\/Forge\/documentation\/Forge\/ModularArchitecture","doc:\/\/Forge\/documentation\/Forge\/SOLIDPrinciples"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Forge\/documentation\/Forge\/XcodePreviewSupport"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Provide preview-safe mock factories that activate automatically in Xcode Previews."}],"variants":[{"paths":["\/documentation\/forge\/xcodepreviewsupport"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Forge"}],"title":"Xcode Preview Support"},"references":{"doc://Forge/documentation/Forge/Scope":{"url":"\/documentation\/forge\/scope","kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scope","kind":"identifier"}],"abstract":[{"type":"text","text":"Defines the lifecycle of a dependency managed by a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Forge\/documentation\/Forge\/Container"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"Scope","kind":"identifier"}],"identifier":"doc:\/\/Forge\/documentation\/Forge\/Scope","role":"symbol","title":"Scope"},"